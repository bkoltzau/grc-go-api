# Required
DJANGO_SECRET_KEY=RANDOM-STRING-FOR-SECRET-KEYS

# For other, look at main/settings.py:env for available options.

# Generate using `cat key | base64 -w 0`
JWT_PRIVATE_KEY_BASE64_ENCODED=
JWT_PUBLIC_BASE64_ENCODED=
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Optional GRC Gold DWH source (used only by GRC sync management commands)
GRC_DWH_DB_HOST=
GRC_DWH_DB_PORT=5432
GRC_DWH_DB_NAME=
GRC_DWH_DB_USER=
GRC_DWH_DB_PASSWORD=
GRC_DWH_DB_SCHEMA=public
GRC_DWH_DB_SSLMODE=require
GRC_DWH_DB_CONNECT_TIMEOUT=10
